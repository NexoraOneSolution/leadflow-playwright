{
  "name": "leadflow-playwright",
  "version": "1.0.0",
  "description": "Playwright-powered toolkit for local business lead research, CSV lead databases, and personalized outreach messaging.",
  "private": true,
  "type": "module",
  "scripts": {
    "collect:maps": "tsx src/collectors/googleMaps.ts",
    "collect:maps:headed": "tsx src/collectors/googleMaps.ts --headed true",
    "message": "tsx scripts/generate-message.ts",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "show-report": "playwright show-report",
    "codegen": "playwright codegen",
    "typecheck": "tsc --noEmit",
    "install:browsers": "playwright install chromium",
    "install:browsers:all": "playwright install"
  },
  "keywords": [
    "lead-generation",
    "leadflow",
    "playwright",
    "outreach",
    "crm",
    "surat",
    "business-leads"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "^25.6.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
